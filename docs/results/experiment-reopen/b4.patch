 }
+
+/** Admin reopens a cancelled order. Goes through the status graph. */
+export function reopenOrder(db: Db, orderId: string): Order {
+  const order = db.findOrder(orderId);
+  if (!order) throw new NotFoundError("Order");
+  const status = nextStatus(order.status, "reopen");
+  db.updateOrder(order.id, { status });
+  return { ...order, status };
+}
diff --git a/tests/reopen.test.ts b/tests/reopen.test.ts
new file mode 100644
index 0000000..cdfbe92
--- /dev/null
+++ b/tests/reopen.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type Order } from "./helpers.js";
+
+describe("admin reopen", () => {
+  it("moves a cancelled order back to PENDING", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder("cus-1");
+    await api.post(`/orders/${order.id}/cancel`, { customerId: "cus-1" });
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+
+    const reopened = await api.post<Order>(`/admin/orders/${order.id}/reopen`);
+    expect(reopened.status).toBe(200);
+    expect(reopened.body.status).toBe("PENDING");
+    expect((await api.view(order.id)).status).toBe("PENDING");
+  });
+
+  it("rejects reopening an order that is not cancelled", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    const response = await api.post(`/admin/orders/${order.id}/reopen`);
+    expect(response.status).toBe(409);
+  });
+
+  it("returns 404 for an unknown order", async () => {
+    const api = createTestApi();
+    const response = await api.post("/admin/orders/nope/reopen");
+    expect(response.status).toBe(404);
+  });
+});
