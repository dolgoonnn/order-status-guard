diff --git a/tests/reopen-order.test.ts b/tests/reopen-order.test.ts
new file mode 100644
index 0000000..3dcc337
--- /dev/null
+++ b/tests/reopen-order.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type Order } from "./helpers.js";
+
+describe("admin: reopen order", () => {
+  it("moves a cancelled order back to PENDING", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder("cus-7");
+    await api.post(`/orders/${order.id}/cancel`, { customerId: "cus-7" });
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+
+    const reopened = await api.post<Order>(`/admin/orders/${order.id}/reopen`);
+    expect(reopened.status).toBe(200);
+    expect(reopened.body.status).toBe("PENDING");
+    expect((await api.view(order.id)).status).toBe("PENDING");
+  });
+
+  it("lets a reopened order be paid again", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post(`/admin/orders/${order.id}/cancel`);
+    await api.post(`/admin/orders/${order.id}/reopen`);
+    await api.post("/internal/payments/invoice-paid", { orderId: order.id });
+    expect((await api.view(order.id)).status).toBe("PAID");
+  });
+
+  it("answers 409 when the order is not cancelled", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    const response = await api.post<{ error: string }>(
+      `/admin/orders/${order.id}/reopen`,
+    );
+    expect(response.status).toBe(409);
+    expect(typeof response.body.error).toBe("string");
+    expect((await api.view(order.id)).status).toBe("PENDING");
+  });
+
+  it("answers 404 for an unknown order", async () => {
+    const api = createTestApi();
+    const response = await api.post("/admin/orders/nope/reopen");
+    expect(response.status).toBe(404);
+  });
+});
