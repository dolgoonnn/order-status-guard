--- a/src/services/order.service.ts
+++ b/src/services/order.service.ts
@@ -63,3 +63,12 @@ export function cancelOrderAsAdmin(db: Db, orderId: string): Order {
   db.updateOrder(order.id, { status });
   return { ...order, status };
 }
+
+/** Admin reopens a cancelled order, e.g. a customer cancelled by mistake. */
+export function reopenOrderAsAdmin(db: Db, orderId: string): Order {
+  const order = db.findOrder(orderId);
+  if (!order) throw new NotFoundError("Order");
+  const status = nextStatus(order.status, "reopen");
+  db.updateOrder(order.id, { status });
+  return { ...order, status };
+}
