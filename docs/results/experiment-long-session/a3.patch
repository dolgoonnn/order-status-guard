+import { describe, expect, it } from "vitest";
+import { createTestApi, type OrderView } from "./helpers.js";
+
+describe("GET /admin/orders customerId filter", () => {
+  it("returns only that customer's orders", async () => {
+    const api = createTestApi();
+    const mine = await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+    const other = await api.createOrder("cus-1");
+
+    const response = await api.get<OrderView[]>("/admin/orders?customerId=cus-1");
+    expect(response.status).toBe(200);
+    expect(response.body.map((order) => order.id)).toEqual([mine.id, other.id]);
+  });
+
+  it("returns every order when no filter is given", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+    const response = await api.get<OrderView[]>("/admin/orders");
+    expect(response.body).toHaveLength(2);
+  });
+
+  it("returns an empty list for a customer with no orders", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    const response = await api.get<OrderView[]>("/admin/orders?customerId=cus-9");
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual([]);
+  });
+});
