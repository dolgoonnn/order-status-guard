@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi } from "./helpers.js";
+
+describe("GET /health", () => {
+  it("reports ok with zero orders on an empty store", async () => {
+    const api = createTestApi();
+    const response = await api.get("/health");
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({ ok: true, orders: 0 });
+  });
+
+  it("counts every order, whatever its status", async () => {
+    const api = createTestApi();
+    const first = await api.createOrder();
+    await api.createOrder("cus-2");
+    await api.post(`/admin/orders/${first.id}/cancel`);
+    const response = await api.get("/health");
+    expect(response.body).toEqual({ ok: true, orders: 2 });
+  });
+
+  it("is read-only: POST is not a route", async () => {
+    const api = createTestApi();
+    const response = await api.app.request("/health", { method: "POST" });
+    expect(response.status).toBe(404);
+  });
+});
diff --git a/tests/invoice-expired.test.ts b/tests/invoice-expired.test.ts
new file mode 100644
index 0000000..45774f1
--- /dev/null
+++ b/tests/invoice-expired.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it } from "vitest";
+import type { Order } from "../src/store.js";
+import { createTestApi } from "./helpers.js";
+
+interface EventBody {
+  applied: boolean;
+  reason?: string;
+  order: Order;
+}
+
+const expired = (orderId: string) => ({ orderId });
+const PATH = "/internal/payments/invoice-expired";
+
+describe("billing: invoice expired", () => {
+  it("cancels a PENDING order", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    const response = await api.post<EventBody>(PATH, expired(order.id));
+    expect(response.status).toBe(200);
+    expect(response.body.applied).toBe(true);
+    expect(response.body.order.status).toBe("CANCELLED");
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+  });
+
+  it("ignores a repeat of the same event", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post(PATH, expired(order.id));
+    const repeat = await api.post<EventBody>(PATH, expired(order.id));
+    expect(repeat.status).toBe(200);
+    expect(repeat.body.applied).toBe(false);
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+  });
+
+  it("never cancels an order that was already paid", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post("/internal/payments/invoice-paid", { orderId: order.id });
+    const late = await api.post<EventBody>(PATH, expired(order.id));
+    expect(late.status).toBe(200);
+    expect(late.body.applied).toBe(false);
+    expect((await api.view(order.id)).status).toBe("PAID");
+  });
+
+  it("answers 404 for an unknown order", async () => {
+    const api = createTestApi();
+    const response = await api.post(PATH, expired("ord-nope"));
+    expect(response.status).toBe(404);
+  });
+
+  it("answers 400 when orderId is missing", async () => {
+    const api = createTestApi();
+    const response = await api.post(PATH, {});
+    expect(response.status).toBe(400);
+  });
+});
diff --git a/tests/order-note.test.ts b/tests/order-note.test.ts
new file mode 100644
index 0000000..7b244a4
--- /dev/null
+++ b/tests/order-note.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type Order, type OrderView } from "./helpers.js";
+
+const items = [{ sku: "cup", quantity: 1, unitPrice: 30000 }];
+
+describe("order note", () => {
+  it("stores a note and returns it from GET /orders/:id", async () => {
+    const api = createTestApi();
+    const created = await api.post<Order>("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "Leave at the door.",
+    });
+    expect(created.status).toBe(201);
+    expect(created.body.note).toBe("Leave at the door.");
+    expect((await api.view(created.body.id)).note).toBe("Leave at the door.");
+  });
+
+  it("accepts a note of exactly 200 characters", async () => {
+    const api = createTestApi();
+    const created = await api.post<Order>("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "x".repeat(200),
+    });
+    expect(created.status).toBe(201);
+  });
+
+  it("leaves the note out when none was sent", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    expect("note" in (await api.view(order.id))).toBe(false);
+  });
+
+  it("rejects a note over 200 characters with 400 and stores nothing", async () => {
+    const api = createTestApi();
+    const response = await api.post<{ error: string }>("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "x".repeat(201),
+    });
+    expect(response.status).toBe(400);
+    expect(response.body.error).toContain("200");
+    expect(api.db.listOrders()).toEqual([]);
+  });
+
+  it("rejects a note that is not text with 400", async () => {
+    const api = createTestApi();
+    const response = await api.post("/orders", { customerId: "cus-1", items, note: 5 });
+    expect(response.status).toBe(400);
+  });
+});
+
+export type { OrderView };
