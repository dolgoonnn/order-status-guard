 import { NotFoundError } from "../errors.js";
 import type { Db, Order } from "../store.js";
 
@@ -13,3 +14,20 @@ export function handleInvoicePaid(db: Db, orderId: string): Order {
   db.updateOrder(order.id, { status: "PAID" });
   return { ...order, status: "PAID" };
 }
+
+/**
+ * Called by billing when an unpaid invoice expires. Only a PENDING order can
+ * expire: a paid or shipped order must never be cancelled by a late callback.
+ * Billing retries webhooks, so an already cancelled order is returned as is.
+ */
+export function handleInvoiceExpired(db: Db, orderId: string): Order {
+  const order = db.findOrder(orderId);
+  if (!order) throw new NotFoundError("Order");
+  if (order.status === "CANCELLED") return order;
+  if (order.status !== "PENDING") {
+    throw new IllegalTransitionError(order.status, "cancel");
+  }
+  const status = nextStatus(order.status, "cancel");
+  db.updateOrder(order.id, { status });
+  return { ...order, status };
+}
