+import { describe, expect, it } from "vitest";
+import { createTestApi } from "./helpers.js";
+
+describe("health", () => {
+  it("reports zero orders on a fresh service", async () => {
+    const api = createTestApi();
+    const res = await api.get<{ ok: boolean; orders: number }>("/health");
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({ ok: true, orders: 0 });
+  });
+
+  it("counts the orders placed", async () => {
+    const api = createTestApi();
+    await api.createOrder();
+    await api.createOrder();
+    const res = await api.get<{ ok: boolean; orders: number }>("/health");
+    expect(res.body).toEqual({ ok: true, orders: 2 });
+  });
+});
diff --git a/tests/invoice-expired.test.ts b/tests/invoice-expired.test.ts
new file mode 100644
index 0000000..ae6b44d
--- /dev/null
+++ b/tests/invoice-expired.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type Order } from "./helpers.js";
+
+const URL = "/internal/payments/invoice-expired";
+
+describe("invoice expired", () => {
+  it("cancels an unpaid order", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    const res = await api.post<Order>(URL, { orderId: order.id });
+    expect(res.status).toBe(200);
+    expect(res.body.status).toBe("CANCELLED");
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+  });
+
+  it("is idempotent when billing retries", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post(URL, { orderId: order.id });
+    const again = await api.post<Order>(URL, { orderId: order.id });
+    expect(again.status).toBe(200);
+    expect(again.body.status).toBe("CANCELLED");
+  });
+
+  it("returns 404 for an unknown order", async () => {
+    const api = createTestApi();
+    const res = await api.post(URL, { orderId: "ord-9999" });
+    expect(res.status).toBe(404);
+  });
+
+  it("returns 400 when orderId is missing", async () => {
+    const api = createTestApi();
+    const res = await api.post(URL, {});
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 409 and keeps a paid order untouched", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post("/internal/payments/invoice-paid", { orderId: order.id });
+    const res = await api.post(URL, { orderId: order.id });
+    expect(res.status).toBe(409);
+    expect((await api.view(order.id)).status).toBe("PAID");
+  });
+});
diff --git a/tests/order-note.test.ts b/tests/order-note.test.ts
