@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type Order } from "./helpers.js";
+
+const items = [{ sku: "tea-100g", quantity: 1, unitPrice: 12000 }];
+
+describe("order note", () => {
+  it("stores the note and returns it from GET /orders/:id", async () => {
+    const api = createTestApi();
+    const created = await api.post<Order>("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "Leave at the gate.",
+    });
+    expect(created.status).toBe(201);
+    expect((await api.view(created.body.id)).note).toBe("Leave at the gate.");
+  });
+
+  it("accepts a note of exactly 200 characters", async () => {
+    const api = createTestApi();
+    const created = await api.post<Order>("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "x".repeat(200),
+    });
+    expect(created.status).toBe(201);
+  });
+
+  it("rejects a note longer than 200 characters", async () => {
+    const api = createTestApi();
+    const response = await api.post("/orders", {
+      customerId: "cus-1",
+      items,
+      note: "x".repeat(201),
+    });
+    expect(response.status).toBe(400);
+  });
+
+  it("rejects a note that is not text", async () => {
+    const api = createTestApi();
+    const response = await api.post("/orders", {
+      customerId: "cus-1",
+      items,
+      note: 5,
+    });
+    expect(response.status).toBe(400);
+  });
+
+  it("leaves the note out when none was given", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    expect((await api.view(order.id)).note).toBeUndefined();
+  });
+});
