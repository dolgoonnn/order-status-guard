new file mode 100644
index 0000000..82f96cc
--- /dev/null
+++ b/tests/admin-orders-filter.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi, type OrderView } from "./helpers.js";
+
+describe("admin order list filter", () => {
+  it("returns only the requested customer's orders", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+    await api.createOrder("cus-1");
+    const list = await api.get<OrderView[]>("/admin/orders?customerId=cus-1");
+    expect(list.status).toBe(200);
+    expect(list.body).toHaveLength(2);
+    expect(list.body.every((o) => o.customerId === "cus-1")).toBe(true);
+  });
+
+  it("returns an empty list for a customer with no orders", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    const list = await api.get<OrderView[]>("/admin/orders?customerId=nobody");
+    expect(list.body).toEqual([]);
+  });
+
+  it("returns every order without the filter", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+    const list = await api.get<OrderView[]>("/admin/orders");
+    expect(list.body).toHaveLength(2);
+  });
+});
