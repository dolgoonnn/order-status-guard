diff --git a/tests/invoice-expired.test.ts b/tests/invoice-expired.test.ts
new file mode 100644
index 0000000..19446d6
--- /dev/null
+++ b/tests/invoice-expired.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import type { Order } from "../src/store.js";
+import { createTestApi } from "./helpers.js";
+
+interface EventBody {
+  applied: boolean;
+  reason?: string;
+  order: Order;
+}
+
+const expired = (orderId: string) => ({ orderId });
+
+describe("billing: invoice expired", () => {
+  it("cancels an unpaid order", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+
+    const response = await api.post<EventBody>("/internal/payments/invoice-expired", expired(order.id));
+    expect(response.status).toBe(200);
+    expect(response.body.applied).toBe(true);
+    expect(response.body.order.status).toBe("CANCELLED");
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+  });
+
+  it("ignores a repeat of the same event", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post("/internal/payments/invoice-expired", expired(order.id));
+
+    const repeat = await api.post<EventBody>("/internal/payments/invoice-expired", expired(order.id));
+    expect(repeat.status).toBe(200);
+    expect(repeat.body.applied).toBe(false);
+    expect((await api.view(order.id)).status).toBe("CANCELLED");
+  });
+
+  it("does not cancel an order that was already paid", async () => {
+    const api = createTestApi();
+    const order = await api.createOrder();
+    await api.post("/internal/payments/invoice-paid", { orderId: order.id });
+
+    const late = await api.post<EventBody>("/internal/payments/invoice-expired", expired(order.id));
+    expect(late.status).toBe(200);
+    expect(late.body.applied).toBe(false);
+    expect((await api.view(order.id)).status).toBe("PAID");
+  });
+
+  it("answers 404 for an unknown order", async () => {
+    const api = createTestApi();
+    const response = await api.post("/internal/payments/invoice-expired", expired("ord-nope"));
+    expect(response.status).toBe(404);
+  });
+
+  it("answers 400 when orderId is missing", async () => {
+    const api = createTestApi();
+    const response = await api.post("/internal/payments/invoice-expired", {});
+    expect(response.status).toBe(400);
+  });
+});
diff --git a/tests/order-note.test.ts b/tests/order-note.test.ts
new file mode 100644
index 0000000..f589ef4
--- /dev/null
+++ b/tests/order-note.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vitest";
+import { createTestApi } from "./helpers.js";
+
+const items = [{ sku: "tea-100g", quantity: 1, unitPrice: 12000 }];
+
+describe("order note", () => {
+  it("stores the note and returns it from GET /orders/:id", async () => {
+    const api = createTestApi();
+    const created = await api.post<{ id: string }>("/orders", { customerId: "cus-1", items, note: "Leave at the door." });
+    expect(created.status).toBe(201);
+    expect((await api.view(created.body.id)).note).toBe("Leave at the door.");
+  });
+
+  it("accepts a note of exactly 200 characters and omits it when absent", async () => {
+    const api = createTestApi();
+    const long = await api.post<{ id: string }>("/orders", { customerId: "cus-1", items, note: "x".repeat(200) });
+    expect(long.status).toBe(201);
+    const plain = await api.createOrder();
+    expect((await api.view(plain.id)).note).toBeUndefined();
+  });
+
+  it("rejects a note over 200 characters with 400", async () => {
+    const api = createTestApi();
+    const response = await api.post("/orders", { customerId: "cus-1", items, note: "x".repeat(201) });
+    expect(response.status).toBe(400);
+  });
+
+  it("rejects a note that is not a string with 400", async () => {
+    const api = createTestApi();
+    const response = await api.post("/orders", { customerId: "cus-1", items, note: 5 });
+    expect(response.status).toBe(400);
+  });
+});
