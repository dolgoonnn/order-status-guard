+import { describe, expect, it } from "vitest";
+import type { OrderView } from "./helpers.js";
+import { createTestApi } from "./helpers.js";
+
+describe("GET /admin/orders", () => {
+  it("returns only the requested customer's orders", async () => {
+    const api = createTestApi();
+    const mine = await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+
+    const response = await api.get<OrderView[]>("/admin/orders?customerId=cus-1");
+    expect(response.status).toBe(200);
+    expect(response.body.map((o) => o.id)).toEqual([mine.id]);
+  });
+
+  it("returns all orders without the filter and none for an unknown customer", async () => {
+    const api = createTestApi();
+    await api.createOrder("cus-1");
+    await api.createOrder("cus-2");
+
+    expect((await api.get<OrderView[]>("/admin/orders")).body).toHaveLength(2);
+    expect((await api.get<OrderView[]>("/admin/orders?customerId=nobody")).body).toEqual([]);
+  });
+});
